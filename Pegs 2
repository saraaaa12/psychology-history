        .era {
            position: relative;
            padding: 35px;
            margin: 35px 0;
            background: white;
            border-radius: 22px;
            border-right: 5px solid #8a6ba5;
            box-shadow: 0 10px 30px rgba(50,40,60,.05);
        }

        .era-number {
            color: #b07f59;
            font-size: 13px;
            font-weight: bold;
        }

        .era h2 {
            color: #4d3d5d;
            margin: 5px 0 15px;
            font-size: 25px;
        }

        .era p {
            color: #666;
            font-size: 15px;
        }

        .highlight {
            margin-top: 20px;
            background: #f0ebf3;
            padding: 18px 22px;
            border-radius: 14px;
            color: #59496a;
            font-size: 14px;
        }

        .year {
            display: inline-block;
